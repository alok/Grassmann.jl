import DirectSum.Ops
import DirectSum.Common
import Grassmann.Scene.Types

/-!
# Straight-Line GPU Codegen (WGSL, GLSL 300 es, Metal MSL) from `DirectSum`

Emits zero-table, loop-free straight-line GPU shader code directly from
`DirectSum.TensorBundle.plan₂` (`out[ic] += coef · x[ia] · y[ib]`) for:

1. **OPNS & IPNS Sphere-Tracing Raymarching Shaders** (`WGSL` for WebGPU,
   `GLSL 300 es` for WebGL2 / Three.js `ShaderMaterial`, and `MSL` for visionOS
   RealityKit `CustomMaterial` / Metal compute) — ports `ganja.js`'s `OPNS_GLSL`/
   `IPNS_GLSL` visualizer into a pure-Lean multi-backend compiler.
2. **Straight-line Clifford Product Kernels** (`emitProductKernel`) for arbitrary
   `TensorBundle` `V`, `BinOp`, and `Layout`s (e.g. PGA3 motor × motor, PGA3 motor
   sandwich, STA geometric product) for GPU vector/multivector fields & physics.

Credits: Michael Reed (`chakravala` / `Grassmann.jl`) and Steven De Keninck
(`enkimute` / `ganja.js`).
-/

namespace Grassmann.Codegen.GPU

open DirectSum Grassmann.Scene

/-- Target GPU shading language. -/
inductive Target where
  | wgsl
  | glsl
  | msl
  deriving DecidableEq, Repr, Inhabited

/-- Format a rational plan coefficient as a clean GPU float literal (`1.0`, `-0.5`, etc.). -/
private def fmtRatLit (q : Rat) : String :=
  if q.den == 1 then
    s!"{q.num}.0"
  else
    s!"({q.num}.0 / {q.den}.0)"

/-- Group `PlanEntry` contributions by output slot `ic` (`0 .. outDim - 1`). -/
private def groupByOutput (outDim : Nat) (entries : Array PlanEntry) :
    Array (Array PlanEntry) := Id.run do
  let mut buckets : Array (Array PlanEntry) := Array.replicate outDim #[]
  for e in entries do
    if e.ic < outDim && e.z == 0 && e.coef != 0 then
      buckets := buckets.set! e.ic (buckets[e.ic]!.push e)
  return buckets

/-- Emit a single sum expression for output slot `ic` given operand expression formatters. -/
private def emitSlotExpr (terms : Array PlanEntry) (fmtA : Nat → String) (fmtB : Nat → String) :
    String :=
  if terms.isEmpty then "0.0"
  else
    let rec go (i : Nat) (acc : String) : String :=
      if i < terms.size then
        let e := terms[i]!
        let prod := s!"({fmtA e.ia}) * ({fmtB e.ib})"
        let termStr :=
          if e.coef == 1 then prod
          else if e.coef == -1 then s!"-({prod})"
          else s!"{fmtRatLit e.coef} * ({prod})"
        let next :=
          if i == 0 then termStr
          else if e.coef == -1 then s!"{acc} - {prod}"
          else if e.coef < 0 then
            let posCoef := fmtRatLit (-e.coef)
            s!"{acc} - {posCoef} * ({prod})"
          else s!"{acc} + {termStr}"
        go (i + 1) next
      else acc
    go 0 ""

/-! ## Straight-Line Clifford Product Kernel Emission -/

/-- Emit a straight-line binary product function in `WGSL`, `GLSL`, or `MSL` directly
from `V.plan₂ op la lb lc` (zero sign tables or nested loops on the GPU). -/
def emitProductKernel (target : Target) (fnName : String)
    (V : TensorBundle) (op : BinOp) (la lb lc : Layout) : Except String String := do
  let entries ← V.plan₂ op la lb lc
  let dimA := la.size V.n
  let dimB := lb.size V.n
  let dimC := lc.size V.n
  let buckets := groupByOutput dimC entries
  let mut lines : Array String := #[]
  match target with
  | .wgsl =>
    lines := lines.push s!"// Generated by Grassmann.Codegen.GPU ({V}, {repr op})"
    lines := lines.push s!"fn {fnName}(a: array<f32, {dimA}>, b: array<f32, {dimB}>) -> array<f32, {dimC}> \{"
    lines := lines.push s!"  var out: array<f32, {dimC}>;"
    for ic in [:dimC] do
      let expr := emitSlotExpr buckets[ic]! (fun i => s!"a[{i}]") (fun j => s!"b[{j}]")
      lines := lines.push s!"  out[{ic}] = {expr};"
    lines := lines.push "  return out;"
    lines := lines.push "}"
  | .glsl =>
    lines := lines.push s!"// Generated by Grassmann.Codegen.GPU ({V}, {repr op})"
    lines := lines.push s!"void {fnName}(in float a[{dimA}], in float b[{dimB}], out float res[{dimC}]) \{"
    for ic in [:dimC] do
      let expr := emitSlotExpr buckets[ic]! (fun i => s!"a[{i}]") (fun j => s!"b[{j}]")
      lines := lines.push s!"  res[{ic}] = {expr};"
    lines := lines.push "}"
  | .msl =>
    lines := lines.push s!"// Generated by Grassmann.Codegen.GPU ({V}, {repr op})"
    lines := lines.push s!"inline void {fnName}(thread const float a[{dimA}], thread const float b[{dimB}], thread float res[{dimC}]) \{"
    for ic in [:dimC] do
      let expr := emitSlotExpr buckets[ic]! (fun i => s!"a[{i}]") (fun j => s!"b[{j}]")
      lines := lines.push s!"  res[{ic}] = {expr};"
    lines := lines.push "}"
  return "\n".intercalate lines.toList

/-! ## Straight-Line OPNS / IPNS Sphere-Tracing Shader Compiler -/

/-- Default 3D point lifting expressions `up(x, y, z)` for standard algebras:
- Conformal Witt `S"∞∅+++"`: `[0.5*(x*x+y*y+z*z), 1.0, x, y, z]` (`v∞, v∅, e₁, e₂, e₃`)
- Raw `Cl(4,1)` (`e₊²=+1, e₋²=-1`): `[x, y, z, 0.5*(x*x+y*y+z*z)-0.5, 0.5*(x*x+y*y+z*z)+0.5]`
- Projective `PGA3` (`D"0,1,1,1"`): `[1.0, x, y, z]`
- Euclidean `ℝ3`: `[x, y, z]` -/
def defaultUpExprs (V : TensorBundle) : Array String :=
  if V.hasconformal && V.n == 5 then
    #["0.5*(x*x+y*y+z*z)", "1.0", "x", "y", "z"]
  else if V.hasconformal && V.n == 4 then
    #["0.5*(x*x+y*y)", "1.0", "x", "y"]
  else if V.n == 5 then
    #["x", "y", "z", "0.5*(x*x+y*y+z*z)-0.5", "0.5*(x*x+y*y+z*z)+0.5"]
  else if V.n == 4 then
    #["1.0", "x", "y", "z"]
  else
    (Array.range V.n).map fun i =>
      match i with | 0 => "x" | 1 => "y" | 2 => "z" | _ => "0.0"

/-- Emit the unrolled `product_len(p, b)` body computing `‖up(p) ∧ b‖` (OPNS) or
`‖up(p) ⌋ b‖` (IPNS) from `V.plan₂`. -/
private def emitNullSpaceBody (target : Target) (V : TensorBundle) (grade : Nat)
    (upExprs : Array String) (isIPNS : Bool) : Except String (Nat × String) := do
  let op : BinOp := if isIPNS then .contractionLeft else .wedge
  let outGrade : Nat :=
    if isIPNS then (if grade ≥ 1 then grade - 1 else 0)
    else grade + 1
  if outGrade > V.n then
    throw s!"grade {grade} exceeds space dimension {V.n} for OPNS"
  let la := Layout.chain 1
  let lb := Layout.chain grade
  let lc := Layout.chain outGrade
  let entries ← V.plan₂ op la lb lc
  let inDim := lb.size V.n
  let outDim := lc.size V.n
  let buckets := groupByOutput outDim entries
  let declF := match target with | .wgsl => "let" | .glsl => "float" | .msl => "float"
  let varF  := match target with | .wgsl => "var sum: f32 = 0.0;" | _ => "float sum = 0.0;"
  let mut lines : Array String := #[]
  for i in [:V.n] do
    let expr := upExprs.getD i "0.0"
    lines := lines.push s!"  {declF} u{i} = {expr};"
  lines := lines.push s!"  {varF}"
  let fmtB : Nat → String :=
    match target with
    | .wgsl => fun j => s!"b[{j / 4}][{j % 4}]"
    | _     => fun j => s!"b[{j}]"
  for ic in [:outDim] do
    if !buckets[ic]!.isEmpty then
      let expr := emitSlotExpr buckets[ic]! (fun i => s!"u{i}") fmtB
      lines := lines.push s!"  {declF} c{ic} = {expr};"
      lines := lines.push s!"  sum += c{ic} * c{ic};"
  lines := lines.push "  return sqrt(abs(sum));"
  return (inDim, "\n".intercalate lines.toList)

/-- Emit a complete GLSL 300 es (WebGL2 / Three.js `ShaderMaterial`) OPNS/IPNS
sphere-tracing fragment shader. -/
def emitOpnsGlsl (V : TensorBundle) (grade : Nat) (isIPNS : Bool := false)
    (upExprs : Array String := defaultUpExprs V) : Except String String := do
  let (dimB, body) ← emitNullSpaceBody .glsl V grade upExprs isIPNS
  let modeName := if isIPNS then "IPNS" else "OPNS"
  return s!"#version 300 es
// Auto-generated by Grassmann.Codegen.GPU ({modeName}, {V}, grade={grade})
precision highp float;
in vec2 vUv;
out vec4 fragColor;
uniform vec3 uCamPos;
uniform vec3 uCamRight;
uniform vec3 uCamUp;
uniform vec3 uCamFwd;
uniform vec4 uColor;
uniform float uThresh;
uniform float uStepSize;
uniform int uMaxSteps;
uniform float uBlade[{dimB}];

float product_len(vec3 p, float b[{dimB}]) \{
  float x = p.x; float y = p.y; float z = p.z;
{body}
}

void main() \{
  vec2 ndc = vUv * 2.0 - 1.0;
  vec3 ro = uCamPos;
  vec3 rd = normalize(uCamFwd + ndc.x * uCamRight + ndc.y * uCamUp);
  vec3 pos = ro;
  float lastd = 1e4;
  bool hit = false;
  for (int i = 0; i < 128; i++) \{
    if (i >= uMaxSteps) break;
    float d = product_len(pos, uBlade);
    float stepLen = uStepSize * (1.0 + 1600.0 * d);
    if (d < uThresh) \{
      pos = pos + rd * clamp((lastd - uThresh) / max(1e-5, lastd - d), 0.0, 1.0) * stepLen;
      hit = true;
      break;
    }
    lastd = d;
    pos += rd * stepLen;
    if (dot(pos - ro, pos - ro) > 100.0) break;
  }
  if (!hit) discard;
  float h = 0.001;
  vec3 n = normalize(vec3(
    product_len(pos + vec3(h,0.0,0.0), uBlade) - product_len(pos - vec3(h,0.0,0.0), uBlade),
    product_len(pos + vec3(0.0,h,0.0), uBlade) - product_len(pos - vec3(0.0,h,0.0), uBlade),
    product_len(pos + vec3(0.0,0.0,h), uBlade) - product_len(pos - vec3(0.0,0.0,h), uBlade)
  ));
  vec3 lightDir = normalize(vec3(2.0, 3.0, 4.0) - pos);
  float diff = max(0.22, abs(dot(n, lightDir)));
  float spec = pow(max(0.0, abs(dot(n, normalize(lightDir - rd)))), 48.0);
  float fresnel = pow(1.0 - abs(dot(n, -rd)), 3.0);
  vec3 col = diff * uColor.rgb + vec3(0.55 * spec + 0.25 * fresnel);
  fragColor = vec4(col, uColor.a);
}
"

/-- Emit a complete WGSL (WebGPU) OPNS/IPNS sphere-tracing fragment shader. -/
def emitOpnsWgsl (V : TensorBundle) (grade : Nat) (isIPNS : Bool := false)
    (upExprs : Array String := defaultUpExprs V) : Except String String := do
  let (dimB, body) ← emitNullSpaceBody .wgsl V grade upExprs isIPNS
  let vec4N := max 1 ((dimB + 3) / 4)
  let modeName := if isIPNS then "IPNS" else "OPNS"
  return s!"// Auto-generated by Grassmann.Codegen.GPU ({modeName}, {V}, grade={grade})
struct OpnsUniforms \{
  camPos   : vec4<f32>,
  camRight : vec4<f32>,
  camUp    : vec4<f32>,
  camFwd   : vec4<f32>,
  color    : vec4<f32>,
  params   : vec4<f32>, // x=thresh, y=stepSize, z=maxSteps, w=aspect
  blade    : array<vec4<f32>, {vec4N}>, // 16-byte uniform-aligned packed {dimB} blade coeffs
};
@group(0) @binding(0) var<uniform> u : OpnsUniforms;

fn product_len(p: vec3<f32>, b: array<vec4<f32>, {vec4N}>) -> f32 \{
  let x = p.x; let y = p.y; let z = p.z;
{body}
}

@fragment
fn fs_main(@location(0) uv: vec2<f32>) -> @location(0) vec4<f32> \{
  let ndc = uv * 2.0 - vec2<f32>(1.0, 1.0);
  let ro = u.camPos.xyz;
  let rd = normalize(u.camFwd.xyz + ndc.x * u.camRight.xyz + ndc.y * u.camUp.xyz);
  var pos = ro;
  var lastd: f32 = 10000.0;
  var hit: bool = false;
  let maxSteps = i32(u.params.z);
  for (var i: i32 = 0; i < 128; i = i + 1) \{
    if (i >= maxSteps) \{ break; }
    let d = product_len(pos, u.blade);
    let stepLen = u.params.y * (1.0 + 1600.0 * d);
    if (d < u.params.x) \{
      hit = true;
      break;
    }
    lastd = d;
    pos = pos + rd * stepLen;
    if (dot(pos - ro, pos - ro) > 100.0) \{ break; }
  }
  if (!hit) \{ discard; }
  let h: f32 = 0.001;
  let n = normalize(vec3<f32>(
    product_len(pos + vec3<f32>(h,0.0,0.0), u.blade) - product_len(pos - vec3<f32>(h,0.0,0.0), u.blade),
    product_len(pos + vec3<f32>(0.0,h,0.0), u.blade) - product_len(pos - vec3<f32>(0.0,h,0.0), u.blade),
    product_len(pos + vec3<f32>(0.0,0.0,h), u.blade) - product_len(pos - vec3<f32>(0.0,0.0,h), u.blade)
  ));
  let lightDir = normalize(vec3<f32>(2.0, 3.0, 4.0) - pos);
  let diff = max(0.22, abs(dot(n, lightDir)));
  let spec = pow(max(0.0, abs(dot(n, normalize(lightDir - rd)))), 48.0);
  let fresnel = pow(1.0 - abs(dot(n, -rd)), 3.0);
  let col = diff * u.color.rgb + vec3<f32>(0.55 * spec + 0.25 * fresnel);
  return vec4<f32>(col, u.color.a);
}
"

/-- Emit a complete Metal MSL (visionOS / macOS RealityKit `CustomMaterial` & Metal
fragment pipeline) OPNS/IPNS sphere-tracing shader. -/
def emitOpnsMsl (V : TensorBundle) (grade : Nat) (isIPNS : Bool := false)
    (upExprs : Array String := defaultUpExprs V) : Except String String := do
  let (dimB, body) ← emitNullSpaceBody .msl V grade upExprs isIPNS
  let modeName := if isIPNS then "IPNS" else "OPNS"
  return s!"// Auto-generated by Grassmann.Codegen.GPU ({modeName}, {V}, grade={grade})
#include <metal_stdlib>
using namespace metal;

struct OpnsUniforms \{
  float4 camPos;
  float4 camRight;
  float4 camUp;
  float4 camFwd;
  float4 color;
  float4 params; // x=thresh, y=stepSize, z=maxSteps, w=aspect
  float  blade[{dimB}];
};

inline float product_len(float3 p, constant float* b) \{
  float x = p.x; float y = p.y; float z = p.z;
{body}
}

fragment float4 opns_fragment(float2 uv [[stage_in]], constant OpnsUniforms& u [[buffer(0)]]) \{
  float2 ndc = uv * 2.0f - 1.0f;
  float3 ro = u.camPos.xyz;
  float3 rd = normalize(u.camFwd.xyz + ndc.x * u.camRight.xyz + ndc.y * u.camUp.xyz);
  float3 pos = ro;
  float lastd = 10000.0f;
  bool hit = false;
  int maxSteps = int(u.params.z);
  for (int i = 0; i < 128; ++i) \{
    if (i >= maxSteps) break;
    float d = product_len(pos, u.blade);
    float stepLen = u.params.y * (1.0f + 1600.0f * d);
    if (d < u.params.x) \{
      hit = true;
      break;
    }
    lastd = d;
    pos += rd * stepLen;
    if (dot(pos - ro, pos - ro) > 100.0f) break;
  }
  if (!hit) discard_fragment();
  const float h = 0.001f;
  float3 n = normalize(float3(
    product_len(pos + float3(h,0.0f,0.0f), u.blade) - product_len(pos - float3(h,0.0f,0.0f), u.blade),
    product_len(pos + float3(0.0f,h,0.0f), u.blade) - product_len(pos - float3(0.0f,h,0.0f), u.blade),
    product_len(pos + float3(0.0f,0.0f,h), u.blade) - product_len(pos - float3(0.0f,0.0f,h), u.blade)
  ));
  float3 lightDir = normalize(float3(2.0f, 3.0f, 4.0f) - pos);
  float diff = max(0.22f, abs(dot(n, lightDir)));
  float spec = pow(max(0.0f, abs(dot(n, normalize(lightDir - rd)))), 48.0f);
  float fresnel = pow(1.0f - abs(dot(n, -rd)), 3.0f);
  float3 col = diff * u.color.rgb + float3(0.55f * spec + 0.25f * fresnel);
  return float4(col, u.color.a);
}
"

/-- Build a complete `OpnsShaderSource` bundle (WGSL + GLSL + MSL) cached by deterministic hash. -/
def compileOpnsBundle (tag : String) (V : TensorBundle) (grade : Nat)
    (isIPNS : Bool := false) : Except String OpnsShaderSource := do
  let wgsl ← emitOpnsWgsl V grade isIPNS
  let glsl ← emitOpnsGlsl V grade isIPNS
  let msl  ← emitOpnsMsl  V grade isIPNS
  let mode := if isIPNS then "ipns" else "opns"
  return { hash := s!"{tag}_g{grade}_{mode}", wgsl, glsl, msl }

/-- Emit straight-line PGA3 even-motor product + sandwich compute shaders in WGSL and MSL. -/
def emitPga3MotorShaders : Except String (String × String) := do
  let wgslMul ← emitProductKernel .wgsl "pga3_motor_mul" DirectSum.PGA3 .mul .even .even .even
  let mslMul  ← emitProductKernel .msl  "pga3_motor_mul" DirectSum.PGA3 .mul .even .even .even
  return (wgslMul, mslMul)

end Grassmann.Codegen.GPU
