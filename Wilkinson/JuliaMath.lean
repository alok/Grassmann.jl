/-- Wrap an integer to a 64-bit pattern. -/
@[inline] def wrap64 (n : Int) : UInt64 := (n % 18446744073709551616).toNat.toUInt64

/-- Julia `table_unpack(N)`: `2^(j/256) ≈ jU + jL` for `j = N mod 256`. -/
@[inline] def tableUnpack (N : Int) : Float × Float :=
  let j := jTable[(N % 256).toNat]!
  (Float.ofBits ((0x3FF0000000000000 : UInt64) ||| (j &&& ((0xFFFFFFFFFFFFFFFF : UInt64) >>> 12))),
   Float.ofBits ((0x3C00000000000000 : UInt64) ||| (j >>> 8)))

/-- Julia `exp(x::Float64)` (`exp_impl(x, Val(:ℯ))`, base/special/exp.jl:207-231). -/
def exp (x : Float) : Float :=
  let magic : Float := 6.755399441055744e15
  let Nf := Float.fma x 369.3299304675746 magic
  let low := (Nf.toBits.toNat % 4294967296 : Nat)
  let N : Int := if low ≥ 2147483648 then (low : Int) - 4294967296 else low
  let Nf := Nf - magic
  let r := Float.fma Nf (-0.002707606173999011) x
  let r := Float.fma Nf (-6.327543041662719e-14) r
  let k := Int.fdiv N 256
  let (jU, jL) := tableUnpack N
  let p := Float.fma r (Float.fma r (Float.fma r 0.04166666857598777 0.1666666857598779) 0.4999999999999997)
    0.9999999999999912
  let small := Float.fma jU (r * p) jL + jU
  let scaled : Unit → Float := fun _ =>
    Float.ofBits (wrap64 ((k * 4503599627370496 : Int) + (small.toBits.toNat : Int)))
  if !(x.abs ≤ 708.3964185322641) then
    if x.isNaN then x
    else if x ≥ 709.7827128933841 then JuliaBase.F64.inf
    else if x ≤ -745.1332191019412 then 0.0
    else if k ≤ -53 then
      Float.ofBits (wrap64 (((k + 53) * 4503599627370496 : Int) + (small.toBits.toNat : Int))) *
        1.1102230246251565e-16
    else scaled ()
  else scaled ()

/-- Julia `log_proc1` (base/special/log.jl:158-187), natural base. -/
@[inline] def logProc1 (y mf F f : Float) : Float :=
  let jp := (128.0 * F).toUInt64.toNat - 127
  let (hiB, loB) := tLog64[jp - 1]!
  let lHi := mf * 0.6931471805601177 + Float.ofBits hiB
  let lLo := mf * (-1.7239444525614835e-13) + Float.ofBits loB
  let u := (2.0 * f) / (y + F)
  let v := u * u
  let q := u * v * Float.fma v 0.012500053168098584 0.08333333333303913
  Float.fma 1.0 lHi (Float.fma 1.0 (u + (q + lLo)) (0.0 * lHi))

/-- Julia `log_proc2` (base/special/log.jl:190-213), natural base. -/
@[inline] def logProc2 (f : Float) : Float :=
  let g := 1.0 / (2.0 + f)
  let u := 2.0 * f * g
  let v := u * u
  let q := u * v * Float.fma v (Float.fma v (Float.fma v 0.0004348877777076146 0.0022321399879194482)
    0.012500000003771751) 0.08333333333333179
  Float.fma 1.0 u (Float.fma 0.0 u (1.0 * Float.fma (Float.fma (-u) f (2.0 * (f - u))) g q))

/-- Julia `log(x::Float64)` (`_log(x, Val(:ℯ), :log)`, base/special/log.jl:264-297). -/
def log (x : Float) : Float :=
  if x > 0.0 then
    if x == JuliaBase.F64.inf then x
    else if 0.9394130628134757 < x && x < 1.0644944589178595 then logProc2 (x - 1.0)
    else
      let (x, m0) :=
        if (x.toBits >>> 52) &&& 0x7ff == 0 then
          let x := x * 1.8014398509481984e16
          (x, ((x.toBits >>> 52) &&& 0x7ff).toNat - (54 : Int))
        else (x, (((x.toBits >>> 52) &&& 0x7ff).toNat : Int))
      let m := m0 - 1023
      let y := Float.ofBits ((x.toBits &&& 0x000FFFFFFFFFFFFF) ||| 0x3FF0000000000000)
      let mf := Float.ofInt m
      let F := (y + 3.5184372088832e13) - 3.5184372088832e13
      logProc1 y mf F (y - F)
  else if x == 0.0 then -JuliaBase.F64.inf
  else JuliaBase.F64.nan

/-- Julia `round(x::Float32)` (to nearest, ties to even). -/
@[inline] def roundEven32 (x : Float32) : Float32 := (JuliaBase.F64.round x.toFloat).toFloat32

/-- Julia `exp(x::Float32)` (`exp_impl(x::Float32, Val(:ℯ))`, base/special/exp.jl:276-295). -/
def exp32 (x : Float32) : Float32 :=
  let Nf := roundEven32 (x * 1.442695)
  let N : Int := (Nf.toFloat).toInt64.toInt
  let r := Float32.fma Nf (-0.69314575) x
  let r := Float32.fma Nf (-1.4286068e-6) r
  let small := Float32.fma r (Float32.fma r (Float32.fma r (Float32.fma r (Float32.fma r (Float32.fma r
    (Float32.fma r 0.00019924171 0.001394858) 0.008333249) 0.041666217) 0.16666667) 0.5) 1.0) 1.0
  if x > 88.72284 then 1.0 / 0.0
  else if x < -103.97208 then 0.0
  else
    let (power, small) := if x ≤ -87.33655 then (N + 127 + 24, small * 5.9604645e-8) else (N + 127, small)
    let (power, small) := if N == 128 then (power - 1, small * 2.0) else (power, small)
    small * Float32.ofBits ((power * 8388608 % 4294967296).toNat.toUInt32)

/-- Julia `log(x::Float32)` (`_log(x::Float32, Val(:ℯ), :log)`, base/special/log.jl:216-333):
the table sum in `Float64`, rounded once. -/
def log32 (x : Float32) : Float32 :=
  if x > 0.0 then
    if x == 1.0 / 0.0 then x
    else if 0.939413 < x && x < 1.0644945 then
      let f := x - 1.0
      let u64 := (2.0 * f).toFloat / (2.0 + f.toFloat)
      let u := u64.toFloat32
      let v := u * u
      let q := u * v * Float32.fma v 0.012512346 0.08333332
      (1.0 * (u64 + q.toFloat)).toFloat32
    else
      let (x, m0) :=
        if (x.toBits >>> 23) &&& 0xff == 0 then
          let x := x * 3.3554432e7
          (x, ((x.toBits >>> 23) &&& 0xff).toNat - (25 : Int))
        else (x, (((x.toBits >>> 23) &&& 0xff).toNat : Int))
      let m := m0 - 127
      let y := Float32.ofBits ((x.toBits &&& 0x007FFFFF) ||| 0x3F800000)
      let mf := Float32.ofInt m
      let F := (y + 65536.0) - 65536.0
      let f := y - F
      let jp := (128.0 * F).toUInt32.toNat - 127
      let l := mf.toFloat * 0.6931471805599453 + Float.ofBits tLog32[jp - 1]!
      let u := (2.0 * f) / (y + F)
      let v := u * u
      let q := u * v * 0.08333351
      (1.0 * (l + (u + q).toFloat)).toFloat32
  else if x == 0.0 then -(1.0 / 0.0)
  else 0.0 / 0.0

